# api-gateway — PRODUCTION environment variables
# Copy to .env on EC2 and fill in real values before running docker-compose.prod.yml
#
# Generate JWT_SECRET:  openssl rand -hex 32
# IMPORTANT: JWT_SECRET must be identical to the value in user-service/.env.prod
# CORS_ORIGIN:          set to http://<EC2_PUBLIC_IP>:3000  (or https:// if behind ALB with TLS)

PORT=8080
USER_SERVICE_URL=http://user-service:3001
TASK_SERVICE_URL=http://task-service:3002
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
CORS_ORIGIN=http://CHANGE_ME_EC2_PUBLIC_IP:3000
